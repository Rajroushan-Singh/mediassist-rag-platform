APP_NAME=MediAssist
APP_ENV=development
DATABASE_URL=sqlite:///./mediassist.db
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Configure the provider you use. Keep real keys in backend/.env only.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
FAISS_INDEX_PATH=./data/faiss_index

# Optional general-information web search; disabled unless explicitly enabled.
ENABLE_WEB_SEARCH=false
SERP_API_KEY=

HEALTH_CONSENT_VERSION=1.0
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENT_CHARS=40000
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=20000000

# Request limits and Prometheus scrape endpoint.
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_ENABLED=true


RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=10
